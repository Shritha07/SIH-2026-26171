{
  "manifest_version": 3,
  "name": "Privacy-Preserving Browser Agent",
  "version": "1.0.0",
  "description": "On-device Visual Perception & Privacy-Preserving Browser Agent (ISRO SIH 26171)",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Privacy Agent"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
